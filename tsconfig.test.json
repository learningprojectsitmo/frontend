{
    /* Тесты исполняются Vitest в Node, поэтому им нужны типы Node: `node:fs`,
       `node:path`, `process.cwd()`. Приложение (`tsconfig.app.json`) их
       исключает — там таких глобалов нет, и появление `process` в коде,
       который уходит в бандл, должно быть ошибкой компиляции.

       Набор файлов тот же, что и раньше: тесты проверяются все, просто в
       окружении, где им доступен Node. */
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "types": ["node", "vite/client"]
    },
    "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/vite-env.d.ts"],
    /* `exclude` наследуется из базового проекта, а он исключает сами тесты —
       без явного сброса проверяться было бы нечего. */
    "exclude": []
}
