FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . ./

ENV NODE_ENV=production

RUN npm run build

# ── runtime: статика (SPA на nginx) ─────────────────────────────
# Edge (nginx+TLS+acme+proxy) живёт В ОТДЕЛЬНОМ контейнере deploy-репо —
# этот образ отдаёт только прибилженную статику (dist) на :80, HTTP-наружу НЕ публикуется.
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY runtime-config.js.template /etc/nginx/templates/config.js.template

ENV NGINX_ENVSUBST_OUTPUT_DIR=/usr/share/nginx/html

# SPA fallback + long-cache для ассетов; TLS/proxy/certbot — не наше дело (это edge).
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /config.js {
        try_files /config.js =404;
        add_header Cache-Control "no-store";
    }

    # Только контент-хешированные бандлы: имя файла меняется вместе с
    # содержимым, поэтому immutable здесь честный.
    # ^~ обязателен: без него регекс-локация ниже проверяется раньше
    # префиксной и забирает /assets/*.js себе.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Нехешированная статика (favicon.svg, apple-touch-icon.png, иконки из
    # public/) по имени не версионируется — immutable здесь вводил бы в
    # заблуждение: после деплоя браузер до 30 дней держал бы старый файл.
    # Директива expires не используется: она добавляет вторую строку
    # Cache-Control поверх add_header, и браузер получает дубликат.
    location ~* \.(?:js|css|map|woff2?|png|jpeg|jpg|gif|svg|ico|webp|txt|pdf)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=604800, must-revalidate" always;
    }

    location / {
        try_files $uri /index.html;
    }
}
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
