FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . ./

ARG VITE_APP_API_URL=/v1
ARG VITE_APP_ENABLE_API_MOCKING=false
ARG VITE_APP_SENTRY_DSN=
ARG VITE_APP_SENTRY_ENVIRONMENT=production
ARG VITE_APP_SENTRY_TRACES_SAMPLE_RATE=0.01
ARG VITE_APP_SENTRY_ERRORS_SAMPLE_RATE=0.5

ENV NODE_ENV=production \
    VITE_APP_API_URL=$VITE_APP_API_URL \
    VITE_APP_ENABLE_API_MOCKING=$VITE_APP_ENABLE_API_MOCKING \
    VITE_APP_SENTRY_DSN=$VITE_APP_SENTRY_DSN \
    VITE_APP_SENTRY_ENVIRONMENT=$VITE_APP_SENTRY_ENVIRONMENT \
    VITE_APP_SENTRY_TRACES_SAMPLE_RATE=$VITE_APP_SENTRY_TRACES_SAMPLE_RATE \
    VITE_APP_SENTRY_ERRORS_SAMPLE_RATE=$VITE_APP_SENTRY_ERRORS_SAMPLE_RATE

RUN npm run build

# ── runtime: статика (SPA на nginx) ─────────────────────────────
# Edge (nginx+TLS+acme+proxy) живёт В ОТДЕЛЬНОМ контейнере deploy-репо —
# этот образ отдаёт только прибилженную статику (dist) на :80, HTTP-наружу НЕ публикуется.
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

# SPA fallback + long-cache для ассетов; TLS/proxy/certbot — не наше дело (это edge).
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /config.js {
        try_files /config.js =404;
        add_header Cache-Control "no-store";
    }

    location ~* \.(?:js|css|map|woff2?|png|jpeg|jpg|gif|svg|ico|webp|txt|pdf)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
    }
}
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
