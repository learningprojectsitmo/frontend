FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . ./

ENV NODE_ENV=production

RUN npm run build

# ── runtime: статика (SPA на nginx) ─────────────────────────────
# Edge (nginx+TLS+acme+proxy) живёт В ОТДЕЛЬНОМ контейнере deploy-репо —
# этот образ отдаёт только прибилженную статику (dist) на :80, HTTP-наружу НЕ публикуется.
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY runtime-config.js.template /etc/nginx/templates/config.js.template

ENV NGINX_ENVSUBST_OUTPUT_DIR=/usr/share/nginx/html

# SPA fallback + long-cache для ассетов; TLS/proxy/certbot — не наше дело (это edge).
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /config.js {
        try_files /config.js =404;
        add_header Cache-Control "no-store";
    }

    location ~* \.(?:js|css|map|woff2?|png|jpeg|jpg|gif|svg|ico|webp|txt|pdf)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
    }
}
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
