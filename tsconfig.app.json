{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "types": ["vite/client"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"]
        },

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src"],
    /* Тесты живут в Node, а не в браузере: `api-trailing-slash.test.ts` читает
       исходники через `node:fs` и знает `process.cwd()`. Типы Node нужны им,
       но не нужны приложению — иначе `process` был бы доступен и в коде,
       который уходит в бандл. У тестов свой проект: `tsconfig.test.json`. */
    "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
